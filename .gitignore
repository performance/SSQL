# Rust
# Generated by Cargo
/target/
**/*.rs.bk
*.pdb

# Cargo.lock should be committed for binary crates (applications)
# but not for library crates. Uncomment if this is a library:
# Cargo.lock

# Build artifacts
/debug/
/release/

# IDE files
*.swp
*.swo
*~
.DS_Store
.idea/
# .vscode/
!/.vscode/tasks.json
!/.vscode/launch.json
*.iml

# ANTLR Generated Files
*.interp
*.tokens
*Lexer.java
*Parser.java
*Listener.java
*BaseListener.java
*Visitor.java
*BaseVisitor.java
*.class

# ANTLR Runtime artifacts (if generating to specific dirs)
/generated/
/antlr-output/

# Keep ANTLR grammar source files
!*.g4

# Test artifacts
/test-results/
*.log

# Documentation builds
/book/
/target/doc/

# Editor backups
*~
.*.swp
.*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
/tmp/

# Environment files
.env
.env.local
.venv/
__pycache__/
*.pyc


# Added by cargo

/target

# Ignore target directories in subprojects
**/target/

# Cargo check/clippy alternate target directories
/target-check/
/target-*/

# SQLite Database files
*.db
*.db-shm
*.db-wal


# SSQL Compiler artifacts
**/generated_sql/
**/results/
# The reviewed golden query results are the result oracle (verify_all.py);
# they are committed.
!/tests/golden/results/
# examples/university_bookstore/results/*.txt are committed reference
# outputs. The same directory also collects local *.sql.txt scratch output
# from manual runs, which stays ignored.
!examples/university_bookstore/results/
examples/university_bookstore/results/*.sql.txt
.antlr/

# Verification Artifacts
tests/transpiled/
tests/transpilation/
tests/analysis/
tests/results/
tests/db/
tests/cache/
failure_log*.txt
verification_progress.json
verification_progress.md
check_output.txt
*_output.txt

# Compiler debug-dump artifacts (--dump-ast/--dump-resolved/--dump-symtable)
*.ast
*.resolved.ast
*.sym
*.ast.txt
**/ast_dumps/

# Node (vendored dependencies must never be committed)
node_modules/

# Prebuilt binaries checked into editor extensions
editors/vscode/bin/
*.vsix
!website/downloads/*.vsix
editors/vscode/out/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.synctex.gz

# One-off/throwaway dev scripts
/scratch/
.pytest_cache/

# Internal only: review notes and paper drafts stay local
/process/reviews/
/docs/papers/
