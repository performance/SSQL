{
    "scopeName": "source.ssql",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ssql",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.double-dash.ssql",
                    "match": "--.*$"
                },
                {
                    "name": "comment.block.ssql",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.ssql",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.ssql",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.devanagari.ssql",
            "match": "(?:^|(?<=[\\s(),।-]))[०-९]+(?:\\.[०-९]+)?(?=[\\s(),।]|$)"
        },
        "punctuation": {
            "name": "punctuation.terminator.danda.ssql",
            "match": "[।॥]"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(चक्रनिवारणेन|अवरोहक्रमेण|आरोहक्रमेण|इत्यस्मात्|वर्जयित्वा|अवशिष्टम्|इत्यस्याः|इत्यासाम्|इत्येषाम्|अनुसारम्|आवर्तिका|आश्रित्य|इत्यनयोः|इत्यनया|इत्यनेन|इत्यस्य|इत्येषु|विशोध्य|सञ्ज्ञा|आधारेण|क्रमेण|नियमेन|प्रदाय|समूहेन|आख्या|आधारे|आरभ्य|मध्ये|चेत्|यत्र|इति|यत्|सह)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.other.dml.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(प्रत्याह्रियताम्|परिवर्त्यन्ताम्|स्थिरीक्रियताम्|परिवर्त्येताम्|विशदीक्रियताम्|निवेश्यन्ताम्|निष्कास्यताम्|परिवर्त्यताम्|आह्रियन्ताम्|निवेश्येताम्|प्रतिदीयताम्|प्रारभ्यताम्|आह्रियेताम्|निवेश्यताम्|स्थाप्यताम्|अभिधीयताम्|आह्रियताम्|प्रतिदीयते|योज्यताम्|लुप्यताम्|रच्यताम्|दीयन्ते|दीयेते|दीयते)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.other.join.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(दक्षिणमेलनेन|पूर्णमेलनेन|प्रतिच्छेदः|वाममेलनेन|वर्जनम्|मेलनेन|सङ्गमः)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.other.modifier.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(वर्तमानपङ्क्तिपर्यन्तम्|अपरिमितपूर्ववर्तितः|वर्तमानपङ्क्तिम्|अनन्तरपङ्क्तेः|चतुर्थांशाङ्कः|पूर्वपङ्क्तेः|पूर्ववर्तितः|अद्वितीयम्|अनिवार्यम्|प्राथमिकम्|विशिष्टस्य|अद्वितीयः|अद्वितीया|अनिवार्यः|अनिवार्या|प्राथमिकः|प्राथमिकी|व्याप्तिः|क्रमिकम्|पङ्क्तयः|भागाङ्कः|विभाजनम्|उत्तरम्|कार्यम्|क्रमिकः|दृश्यम्|शुद्धम्|अवरोहः|बद्धम्|सर्वम्|आरोहः|पटलम्|बद्धः|बद्धा|सूची)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.other.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(द्वितीयानन्तरपङ्क्तेः|चतुर्थानन्तरपङ्क्तेः|द्वितीयपूर्वपङ्क्तेः|अष्टमानन्तरपङ्क्तेः|चतुर्थपूर्वपङ्क्तेः|तृतीयानन्तरपङ्क्तेः|पञ्चमानन्तरपङ्क्तेः|सप्तमानन्तरपङ्क्तेः|अष्टमपूर्वपङ्क्तेः|तृतीयपूर्वपङ्क्तेः|पञ्चमपूर्वपङ्क्तेः|षष्ठानन्तरपङ्क्तेः|सप्तमपूर्वपङ्क्तेः|अपरिमितानुवर्तितः|दशमानन्तरपङ्क्तेः|नवमानन्तरपङ्क्तेः|षष्ठपूर्वपङ्क्तेः|आद्यमहावर्णरूपम्|ऊर्ध्वपूर्णाङ्कः|दशमपूर्वपङ्क्तेः|नवमपूर्वपङ्क्तेः|प्रतिसंह्रियताम्|प्राकृतिकलघुगणकः|व्युत्क्रमकोज्या|ऋणात्मिकाभ्याम्|वर्तमानपङ्क्तिः|सङ्ग्रहबिन्दुम्|ऋणात्मकाभ्याम्|कोटिस्पर्शज्या|दक्षिणमार्जनम्|पूर्णाङ्करूपेण|वर्तमानपङ्क्ति|व्युत्क्रमज्या|सङ्ग्रहबिन्दुः|अधःपूर्णाङ्कः|ऋणात्मिकानाम्|ऋणात्मिकाभ्यः|ऋणात्मिकायाम्|चापस्पर्शज्या|निरपेक्षमानम्|प्रतिस्थापनम्|वास्तविकरूपेण|ऋणात्मकानाम्|ऋणात्मकेभ्यः|ऋणात्मिकाभिः|ऋणात्मिकायाः|दिनाङ्करूपेण|धनर्णचिह्नम्|निवर्त्यताम्|पुनरावृत्तिः|प्ररूपितकालः|महावर्णरूपम्|लघुवर्णरूपम्|विशिष्टानाम्|अद्यतनक्षणः|अद्वितीयानि|अनिवार्याणि|अनुमन्यताम्|अन्त्यखण्डः|ऋणात्मिकयोः|ऋणात्मिकाम्|ऋणात्मिकायै|ऋणात्मिकासु|तात्कालिकम्|दिनाङ्कसमयः|पङ्क्तीनाम्|पुनरुक्तिम्|पूर्णलब्धिः|प्राथमिकानि|प्राथमिक्यः|वाममार्जनम्|विभाजनखण्डः|विशिष्टायाः|वैकल्पिकानि|वैकल्पिक्यः|अद्वितीयाः|अनावृत्तम्|अनिवार्याः|अनुवर्तितः|अन्यस्मिन्|अवशिष्टस्य|अवशिष्टात्|ऋणात्मकयोः|ऋणात्मकस्य|ऋणात्मकात्|ऋणात्मकानि|ऋणात्मकान्|ऋणात्मकेषु|ऋणात्मिकया|ऋणात्मिकाः|तात्कालिकः|द्वैतरूपेण|प्राथमिकाः|यादृच्छिकः|वाक्यरूपेण|विशिष्टयोः|वैकल्पिकम्|वैकल्पिकाः|सन्निकटनम्|समूहनियमेन|सम्बद्धान्|सर्वमेलनेन|सर्वसङ्गमः|स्पर्शज्या|अवशिष्टेन|ऋणात्मकम्|ऋणात्मकाः|ऋणात्मकाय|ऋणात्मकेन|ऋणात्मकैः|ऋणात्मिका|ऋणात्मिके|क्रमिकाणि|चापकोज्या|दैर्घ्यम्|पर्यन्तम्|महत्तमस्य|महत्तमात्|वर्गमूलम्|वैकल्पिकः|वैकल्पिकी|अनुरूपेण|आदिखण्डः|इत्याभिः|इत्येभिः|ऋणात्मकः|ऋणात्मके|ऋणात्मकौ|क्रमिकाः|घाताङ्कः|चापमानम्|महत्तमेन|माध्यस्य|माध्यात्|मार्जनम्|लघुतमस्य|लघुतमात्|विपरीतम्|संयोजनम्|अन्तरम्|अन्यान्|अपसारेण|इत्यासु|कोणांशः|क्रमिका|गणनायाः|गुणनस्य|गुणनात्|चापज्या|तस्मात्|तस्मिन्|परिणामः|बद्धानि|माध्येन|यस्मिन्|युगसमयः|लघुगणकः|लघुतमम्|लघुतमेन|लब्धस्य|लब्धात्|विकल्पः|सर्वत्र|सूच्याः|सूत्रम्|अन्यत्|इतीदम्|कोज्या|गणनाम्|गुणनेन|बद्धाः|बाह्या|मित्या|योगस्य|योगात्|लब्धम्|लब्धेन|विभज्य|समूहम्|समूहाः|सूचीम्|गणनया|प्रति|योगम्|योगेन|वरणम्|घातः|ज्या|वारः|विना|शेषः|समयः|अपि|तथा)(?=[\\s(),।]|$)"
                }
            ]
        },
        "types": {
            "name": "storage.type.ssql",
            "match": "(?:^|(?<=[\\s(),।]))(नपुंसकलिङ्गम्|स्त्रीलिङ्गम्|पुंलिङ्गम्|पूर्णाङ्कः|द्विवचनम्|वास्तविकः|दिनाङ्कः|बहुवचनम्|एकवचनम्|द्वैतम्|वाक्यम्)(?=[\\s(),।]|$)"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(विद्यते|नास्ति|अस्ति|वा|च|न)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.operator.comparison.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(न्यूनम्|रिक्तम्|अधिकम्|न्यूनः|न्यूना|रिक्तः|रिक्ता|सदृशम्|अधिकः|अधिका|सदृशः|सदृशी|समम्|समः|समा)(?=[\\s(),।]|$)"
                },
                {
                    "name": "keyword.operator.date.ssql",
                    "match": "(?:^|(?<=[\\s(),।]))(अद्यतनदिनाङ्कः|अद्यतनसमयः|क्षणम्|निमेषः|वर्षम्|क्षणः|दिनम्|मासः|होरा)(?=[\\s(),।]|$)"
                }
            ]
        },
        "functions": {
            "name": "support.function.ssql",
            "match": "(?:^|(?<=[\\s(),।]))(पङ्क्तिसङ्ख्या|वर्णानाम्|सघनश्रेणी|महत्तमम्|स्थानात्|माध्यम्|स्थानम्|गुणनम्|श्रेणी|खण्डः|गणना|योगः)(?=[\\s(),।]|$)"
        }
    }
}
